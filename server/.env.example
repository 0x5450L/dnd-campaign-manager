NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://dnd_user:dnd_secret@localhost:5432/dnd_campaign_db"
JWT_SECRET="change-me-to-a-real-secret"

# Leave CORS_ORIGINS unset when the API and the client share an origin, which is
# how production is meant to run: the server hands out the built client itself.
# Set a comma-separated list only when they are deployed apart; that also flips
# the auth cookie to SameSite=None and forces Secure.
# CORS_ORIGINS=https://dnd.example.com

# Absolute path to the built client. When set, the server serves it and falls
# back to index.html for client-side routes.
# CLIENT_DIST_PATH=/app/client/dist

# Optional. Falls back to an in-memory cache for SRD lookups when unset.
# REDIS_URL=redis://localhost:6379

# Demo deployments only. Rebuilds the demo campaign on this interval, skipping
# ticks while anyone is connected. Leave unset anywhere real: it deletes and
# recreates the demo accounts and everything they own.
# DEMO_RESEED_HOURS=6

# Leave AI_PROVIDER unset to pick gemini when a key is present and mock otherwise.
# AI_PROVIDER=mock
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
